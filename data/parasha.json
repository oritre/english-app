 "about": {
  "p-vayetze": "החלום על הסולם, רחל ולאה, שבטי ישראל, והדרך חזרה הביתה",
  "p-vayishlach": "יעקב נפגש עם עשיו, המאבק עם המלאך, ושמו נקרא ישראל",
  "p-vayeshev": "יוסף וחלומותיו, מכירת יוסף, ויוסף בבית פוטיפר",
  "p-miketz": "חלומות פרעה, יוסף משנה למלך, והאחים יורדים למצרים",
  "p-vayigash": "יהודה ניגש, יוסף מתוודע לאחיו, ויעקב יורד למצרים",
  "p-vayechi": "ברכות יעקב לבניו ולנכדיו, ופטירתו",
  "p-shemot": "שעבוד מצרים, לידת משה, והסנה הבוער",
  "p-vaera": "משה ואהרן אצל פרעה, ושבע המכות הראשונות",
  "p-bo": "המכות האחרונות, קורבן פסח ויציאת מצרים",
  "p-beshalach": "קריעת ים סוף, שירת הים, המן ועמלק",
  "p-yitro": "יתרו מצטרף, ומתן תורה בהר סיני",
  "p-mishpatim": "דינים בין אדם לחברו, ו\"נעשה ונשמע\"",
  "p-terumah": "בניית המשכן: הארון, השולחן והמנורה",
  "p-tetzaveh": "שמן למאור, ובגדי הכהונה",
  "p-ki-tisa": "מחצית השקל, חטא העגל, והלוחות השניים",
  "p-vayakhel": "השבת, ונדבת העם למשכן",
  "p-pekudei": "חשבון המשכן, והקמתו"
 }
